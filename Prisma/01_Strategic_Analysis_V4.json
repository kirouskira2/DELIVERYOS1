{
  "strategicAnalysis": {
    "projectIdentity": {
      "name": "Prisma AI - Governance Automation Platform",
      "version": "V4.1",
      "coreValueProp": "Uma fábrica de software autônoma que transforma especificações de negócio em plataformas governadas, utilizando agentes de política e zero hard-coding.",
      "targetAudience": ["Startups", "Enterprises", "Desenvolvedores"]
    },
    "domainMap": {
      "entities": [
        {
          "name": "ProjectConfiguration",
          "description": "A especificação do SaaS do cliente. No Dashboard, isso é o item principal gerenciado."
        },
        {
          "name": "GeneratedArtifact",
          "description": "O código e documentos gerados (SQL, OpenAPI, Planos). É o 'produto' entregue."
        },
        {
          "name": "PolicyAgent",
          "description": "O microsserviço de governança. No Prisma, monitoramos a saúde desses agentes."
        }
      ],
      "actors": [
        "Arquiteto (Usuário Admin)",
        "Agente TRM (Sistema)",
        "Auditor (Sistema)"
      ]
    },
    "visualRefactoringPlan": {
      "sourcePrototype": "dashboard.txt (FitTrack Pro Layout)",
      "targetContext": "Prisma AI Control Center",
      "mappings": [
        {
          "uiElement": "Summary Cards (Topo)",
          "transformations": [
            { "from": "Total Revenue", "to": "Projetos Ativos", "dataSource": "count(ProjectConfiguration)" },
            { "from": "Total Expenses", "to": "Tokens Consumidos", "dataSource": "sum(usage_logs.tokens)" },
            { "from": "Net Profit", "to": "Economia Gerada", "dataSource": "calculated_value" },
            { "from": "Upcoming Charges", "to": "Builds em Fila", "dataSource": "queue.length" }
          ]
        },
        {
          "uiElement": "Visualizations (Gráficos)",
          "transformations": [
            { "from": "Revenue vs Expenses", "to": "Sucesso vs Falha (Builds)", "chartType": "Tremor BarChart" },
            { "from": "Revenue by Plan", "to": "Tipos de Artefato Gerados", "chartType": "Tremor DonutChart" }
          ]
        },
        {
          "uiElement": "Transactions Table",
          "transformations": [
            { "from": "Transaction List", "to": "Log de Auditoria e Geração", "columns": ["Data", "Projeto", "Agente", "Status (Aprovado/Reprovado)", "Custo"] }
          ]
        },
        {
          "uiElement": "Sidebar Navigation",
          "transformations": [
            { "from": "Dashboard", "to": "Visão Geral" },
            { "from": "Clients", "to": "Projetos" },
            { "from": "Training", "to": "Meus Agentes" },
            { "from": "Finances", "to": "Governança" },
            { "from": "Marketing", "to": "Configurações" }
          ]
        }
      ]
    },
    "governanceStrategy": {
      "rulesLocation": "Supabase Storage bucket 'prisma-rules'",
      "policyAgents": [
        "Agent_Architect_Policy (Valida se o manifesto segue o padrão V4)",
        "Agent_Security_Policy (Valida se não há keys hard-coded)"
      ]
    }
  }
}